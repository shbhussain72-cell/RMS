# ─────────────────────────────────────────────────────────────────────────────
# VITE_REVIEW_TOOLS
#
# Mounts the internal review tooling — the Remarks pin/panel and the LSD Coverage
# panel — in ANY build, including the deployed one.
#
#   true            tools present. Use for local dev and for the Vercel PREVIEW
#                   deployment while an internal review is running.
#   unset / other   none of the tool code exists in the bundle at all. This is a
#                   real absence, not a hidden UI: Vite folds the flag to a literal
#                   and Rollup drops the modules. `npm run check:gate` builds both
#                   ways and asserts the difference.
#
# Read it through src/reviewTools.ts. Never inline the variable name at a call
# site — a typo there is permanently falsy and looks exactly like the flag being
# off.
#
# Vercel: Settings → Environment Variables. Env changes only take effect on a NEW
# build, so redeploy after adding it. Remove it from Production before anything
# real ships.
# ─────────────────────────────────────────────────────────────────────────────
VITE_REVIEW_TOOLS=true

# ═════════════════════════════════════════════════════════════════════════════
# SERVER-SIDE ONLY — none of the following carries a VITE_ prefix, so Vite
# cannot inline it into the client bundle. `scripts/check-dev-only.mjs` asserts
# every one of these names is absent from dist/ rather than trusting that
# convention, because a convention is one careless rename away.
#
# Set these in Vercel → Settings → Environment Variables. They are NOT read from
# this file in production; it documents what has to exist and where.
# ═════════════════════════════════════════════════════════════════════════════

# The shared store. Vercel Blob, created from the Storage tab; the token is
# offered when the store is connected to the project.
#   Scope: Preview + Production
BLOB_READ_WRITE_TOKEN=

# The server-side gate. Every /api handler returns 404 unless this is exactly
# "true", so an accidental deploy of the functions exposes nothing.
#   Scope: Preview + Production
REVIEW_API=true

# ── The wordlist sync ────────────────────────────────────────────────────────
#
# WORDLIST_SYNC_TOKEN is a fine-grained GitHub personal access token. It can
# rewrite the source of truth for every translation in the app, so it is scoped
# as narrowly as GitHub allows:
#
#   Resource owner      the account that owns this repository
#   Repository access   ONLY select repositories → this one
#   Permissions         Repository permissions → Contents: Read and write
#                       (nothing else — no Actions, no Workflows, no metadata
#                        beyond the read GitHub adds automatically)
#   Expiration          set one. A sync that stops working loudly is better than
#                       a token that lives forever.
#
#   Scope: Preview + Production
WORDLIST_SYNC_TOKEN=

# owner/name of the repository holding the spreadsheet.
#   Scope: Preview + Production
WORDLIST_REPO=

# Branch the sync commits to. Defaults to main if unset.
#   Scope: Preview + Production
WORDLIST_BRANCH=main

# Path to the workbook inside that repository. Defaults to the name below.
#   Scope: Preview + Production
WORDLIST_PATH=RMS_Mumineen_LSD_wordlist_v4.xlsx

# Shared secret for the nightly run. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` to /api/cron/sync-wordlist, which returns
# 500 if it is unset — an unset secret must not read as "no check required" on
# an endpoint that commits to a repository.
#   Scope: Production (the schedule only runs there)
CRON_SECRET=
