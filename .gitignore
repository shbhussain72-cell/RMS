# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
.vite/
dev-dist/

# Environment & secrets
#
# KEEP THIS AS ONE BLOCK. gitignore is LAST-MATCH-WINS, so a negation only holds until
# something below it matches the same path again. A second `.env*` rule was appended near the
# bottom of this file, which silently killed the `!.env.example` here: the one file documenting
# every server-side variable and the exact PAT scope the sync needs was never in the
# repository at all, and nothing failed to say so.
#
# So the negation must be the LAST word on `.env` paths. Add nothing about `.env` below.
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor & IDE
.vscode/
.idea/
*.suo
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Test & coverage
coverage/
.nyc_output/

# Misc
*.pem
*.key

# TS build info
*.tsbuildinfo

# LSD coverage report (regenerated on demand; src/i18n/lsd.json IS committed on purpose —
# it is the build artifact the app imports)
lsd-coverage.json
.vercel

# Audit output — screenshots are regenerated by `npm run shoot`, never committed
artifacts/

# Wordlist backups — snapshots taken before destructive merges, not source of truth.
# The live wordlist (RMS_Mumineen_LSD_wordlist_v4.xlsx) IS tracked.
*.BACKUP-*.xlsx
#
# NAMED, not globbed. These two are dead one-off exports that nothing references; they are
# listed only to keep `git status` quiet. `RMS_remaining_*.xlsx` would also have swallowed a
# real `RMS_remaining_2027.xlsx` the day the wordlist owner handed one over — same class as
# the `.env.example` above, a deliverable that arrives and vanishes with nothing failing.
RMS_remaining_TO_TRANSLATE.xlsx
RMS_untranslated_TRANSLATED_v2.xlsx

# Dictionary edits staged in the browser editor, awaiting a paste into the .xlsx.
# Local by design: the build refuses to run while this file is non-empty.
wordlist-overrides.json
