# TS build info
*.tsbuildinfo

# LSD coverage report (regenerated on demand; src/i18n/lsd.json IS committed on purpose —
# it is the build artifact the app imports)
lsd-coverage.json
.vercel
.env*
# ...except the template. `.env*` was swallowing it, so the one file that documents
# which variables exist, what they are scoped to and how narrowly the GitHub PAT is
# permissioned has never been in the repository — it lived on one machine, which is
# the opposite of what a .example file is for. It contains no values.
!.env.example

# Audit output — screenshots are regenerated by `npm run shoot`, never committed
artifacts/

# Wordlist backups — snapshots taken before destructive merges, not source of truth.
# The live wordlist (RMS_Mumineen_LSD_wordlist_v4.xlsx) IS tracked.
*.BACKUP-*.xlsx
RMS_untranslated_*.xlsx
RMS_remaining_*.xlsx

# Dictionary edits staged in the browser editor, awaiting a paste into the .xlsx.
# Local by design: the build refuses to run while this file is non-empty.
wordlist-overrides.json
