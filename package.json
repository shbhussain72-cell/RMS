{
  "name": "miqaat-registration-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:lsd": "node scripts/build-lsd-dict.mjs",
    "check:lsd": "node scripts/check-lsd-coverage.mjs",
    "check:bidi": "node scripts/check-bidi.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run build:lsd && vite",
    "build": "npm run build:lsd && npm run check:lsd && tsc -b && vite build && node scripts/check-dev-only.mjs",
    "preview": "vite preview",
    "audit:lsd": "node scripts/audit-lsd.mjs --write",
    "shoot": "npm run build && node scripts/shoot.mjs",
    "sweep:logical": "node scripts/logical-props.cjs",
    "census:centring": "node scripts/centring-census.cjs",
    "census:mirror": "node scripts/mirror-census.cjs",
    "check:remarks": "node scripts/check-remarks.mjs",
    "check:devonly": "node scripts/check-dev-only.mjs",
    "check:anchor": "node scripts/check-anchor.mjs",
    "check:chrome": "node scripts/check-chrome.mjs",
    "check:devdock": "node scripts/check-devdock.mjs",
    "check:dictionary": "node scripts/check-dictionary.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9",
    "wawoff2": "^2.0.1",
    "xlsx": "^0.18.5"
  }
}
